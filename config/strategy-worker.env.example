# Local-only queue and artifact locations. Copy to /etc/ciclotrade-worker/worker.env.
TRADEAI_STRATEGY_WORKER_QUEUE_DB=/var/lib/ciclotrade-worker/backtest-queue.db
TRADEAI_STRATEGY_WORKER_ARTIFACT_DIR=/var/lib/ciclotrade-worker/artifacts
TRADEAI_STRATEGY_WORKER_ID=hk-strategy-worker
TRADEAI_STRATEGY_WORKER_LEASE_SECONDS=60
TRADEAI_STRATEGY_WORKER_POLL_SECONDS=2
TRADEAI_STRATEGY_WORKER_HARD_TIMEOUT_SECONDS=900

# Compute Gate: controlled local drops only. The timer may invoke one bounded
# import/execution pass; the application still enforces the Hong Kong window.
TRADEAI_COMPUTE_DROP_DIR=/var/lib/ciclotrade-worker/inbox
TRADEAI_COMPUTE_ALLOWED_SYMBOLS=AAPL,MSFT,NVDA,SPY,QQQ
TRADEAI_COMPUTE_TIMEZONE=Asia/Hong_Kong
TRADEAI_COMPUTE_OFFPEAK_START=00:30
TRADEAI_COMPUTE_OFFPEAK_END=06:30
TRADEAI_COMPUTE_MAX_CPU_PERCENT=60
TRADEAI_COMPUTE_MAX_MEMORY_PERCENT=75
TRADEAI_COMPUTE_MIN_FREE_BYTES=2147483648
TRADEAI_COMPUTE_MAX_INPUT_BYTES=8388608
TRADEAI_COMPUTE_MAX_DAILY_JOBS=12
# Atomic ceiling on actual system attempt claims in each Hong Kong budget day.
TRADEAI_COMPUTE_MAX_DAILY_RUNS=12
TRADEAI_COMPUTE_MAX_PENDING_JOBS=4
TRADEAI_COMPUTE_MAX_REQUESTS_PER_RUN=1
TRADEAI_COMPUTE_ORPHAN_MIN_AGE_SECONDS=3600

# P0 is local research-only. Any truthy value is rejected during startup.
TRADEAI_STRATEGY_WORKER_OUTBOUND_PUBLISH_ENABLED=false
TRADEAI_STRATEGY_WORKER_PUBLISH=false
