# Copy with sudoedit to /etc/ciclotrade-worker/producer.env, then set owner
# root:root and mode 0600. Do not commit the real file.
#
# The producer is disabled by default. When enabled it evaluates only the
# canonical 13 system stocks using daily research data, and writes shadow-only
# evidence into the local spool. It does not connect to, install, or move OpenD.
TRADEAI_SYSTEM_CYCLE_PRODUCER_ENABLED=false
TRADEAI_SYSTEM_CYCLE_SPOOL_DB=/var/lib/ciclotrade-worker/system-cycle-spool.db
MARKET_DATA_ENABLED=false
