# Root-owned deployment template. Keep disabled until the independent release gate.
TRADEAI_EXPANDED_RESEARCH_PUBLISH_ENABLED=false
TRADEAI_EXPANDED_RESEARCH_PUBLISH_SOURCE_SPOOL=/var/lib/ciclotrade-worker/expanded-research/results.db
TRADEAI_EXPANDED_RESEARCH_PUBLISH_STATE_DB=/var/lib/ciclotrade-worker/expanded-research/publisher-state.db
TRADEAI_EXPANDED_RESEARCH_PUBLISH_BASE_URL=https://ciclotrade.com
TRADEAI_EXPANDED_RESEARCH_PUBLISH_WORKER_ID=expanded-research-publisher
# Set only in the root-owned 0600 environment; never commit a real secret.
TRADEAI_EXPANDED_RESEARCH_PUBLISH_SHARED_SECRET=REPLACE_WITH_32_BYTE_SECRET
