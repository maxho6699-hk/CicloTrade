# Copy with sudoedit to /etc/ciclotrade-worker/compute-evidence.env.
# Keep the real file root:root mode 0600. Never commit or print its secret.
# Both local stages are disabled until the receiver and exact release pass the
# integration gate represented by enable-compute-evidence.after-integration.
TRADEAI_COMPUTE_EVIDENCE_EXPORTER_ENABLED=false
TRADEAI_COMPUTE_EVIDENCE_PUBLISHER_ENABLED=false

# The exporter reads the canonical local queue and immutable artifacts, then
# writes a separate delivery spool. The spool path must not equal the queue DB.
TRADEAI_STRATEGY_WORKER_QUEUE_DB=/var/lib/ciclotrade-worker/backtest-queue.db
TRADEAI_STRATEGY_WORKER_ARTIFACT_DIR=/var/lib/ciclotrade-worker/artifacts
TRADEAI_COMPUTE_EVIDENCE_SPOOL_DATABASE=/var/lib/ciclotrade-worker/compute-evidence/spool.db
TRADEAI_COMPUTE_EVIDENCE_EXPORT_MAX_PER_RUN=4

# These identities must exactly match the website receiver allowlist.
TRADEAI_COMPUTE_EVIDENCE_SITE_ID=hk-strategy-worker
TRADEAI_COMPUTE_EVIDENCE_PUBLISHER_ID=compute-evidence-publisher
TRADEAI_COMPUTE_EVIDENCE_SHARED_SECRET=

TRADEAI_COMPUTE_EVIDENCE_CONNECT_TIMEOUT=5
TRADEAI_COMPUTE_EVIDENCE_TOTAL_TIMEOUT=20
TRADEAI_COMPUTE_EVIDENCE_MAX_RESPONSE_BYTES=65536
TRADEAI_COMPUTE_EVIDENCE_LEASE_SECONDS=90
TRADEAI_COMPUTE_EVIDENCE_EXPIRY_SECONDS=120
TRADEAI_COMPUTE_EVIDENCE_MAX_RETRY_AFTER=3600
