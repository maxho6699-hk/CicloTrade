# Copy with sudoedit to /etc/ciclotrade-worker/publisher.env, then set owner
# root:root and mode 0600. Do not commit the real file or paste its secret into
# shells, systemd commands, logs, tickets, or chat.
#
# This database path is the strategy node's local spool, not the website
# receiver database. The shared secret must match the website receiver and be
# an independent random value of at least 32 bytes.
TRADEAI_SYSTEM_CYCLE_PUBLISHER_ENABLED=false
TRADEAI_SYSTEM_CYCLE_RESEARCH_DATABASE=/var/lib/ciclotrade-worker/system-cycle-spool.db
TRADEAI_SYSTEM_CYCLE_RESEARCH_SHARED_SECRET=
TRADEAI_SYSTEM_CYCLE_PUBLISHER_CONNECT_TIMEOUT=5
TRADEAI_SYSTEM_CYCLE_PUBLISHER_TOTAL_TIMEOUT=20
TRADEAI_SYSTEM_CYCLE_PUBLISHER_LEASE_SECONDS=90
