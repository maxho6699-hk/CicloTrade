# Copy with sudoedit to /etc/ciclotrade-worker/candidate-source-freezer.env.
# Keep the real file root:root mode 0600. Do not commit deployment files.
# This network source service is disabled until an integration owner creates
# its separate enable marker. It writes only the controlled source directory.
TRADEAI_CANDIDATE_SOURCE_FREEZER_ENABLED=false
MARKET_DATA_ENABLED=false
TRADEAI_CANDIDATE_SOURCE_DIR=/var/lib/ciclotrade-worker/candidate-sources

# Only these explicit US symbols may be fetched. A run writes at most this
# file (P0 one-file transaction) and is accepted in the same off-peak window
# as the downstream Compute Gate. Session timestamps remain America/New_York.
TRADEAI_COMPUTE_ALLOWED_SYMBOLS=AAPL,MSFT,NVDA,SPY,QQQ
TRADEAI_CANDIDATE_SOURCE_MAX_SYMBOLS_PER_RUN=1
TRADEAI_COMPUTE_TIMEZONE=Asia/Hong_Kong
TRADEAI_COMPUTE_OFFPEAK_START=00:30
TRADEAI_COMPUTE_OFFPEAK_END=06:30
