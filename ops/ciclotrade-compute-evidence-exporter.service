[Unit]
Description=CicloTrade verified compute evidence exporter
After=local-fs.target
RequiresMountsFor=/var/lib/ciclotrade-worker
ConditionPathExists=/etc/ciclotrade-worker/enable-compute-evidence.after-integration

[Service]
Type=oneshot
User=cicloworker
Group=cicloworker
WorkingDirectory=/opt/ciclotrade-worker/current
EnvironmentFile=/etc/ciclotrade-worker/compute-evidence.env
ExecStart=/opt/ciclotrade-worker/current/.venv/bin/python -m src.apps.worker.compute_evidence_exporter
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/var/lib/ciclotrade-worker/backtest-queue.db /var/lib/ciclotrade-worker/artifacts
# SQLite's WAL reader may update lock bookkeeping in a pre-existing -shm file.
# Prefixing only that optional file with "-" keeps startup safe when SQLite has
# removed it after the last writer closed; the canonical DB, WAL, and artifacts
# remain read-only, and the exporter still fails closed if the queue is absent.
ReadWritePaths=-/var/lib/ciclotrade-worker/backtest-queue.db-shm /var/lib/ciclotrade-worker/compute-evidence
RestrictAddressFamilies=AF_UNIX
MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%
TasksMax=32
LimitNOFILE=1024
