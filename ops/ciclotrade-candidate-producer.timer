[Unit]
Description=Offer bounded local candidate proposals during the Hong Kong Compute Gate window

[Timer]
OnCalendar=*-*-* 00:50:00 Asia/Hong_Kong
OnCalendar=*-*-* 01:20:00 Asia/Hong_Kong
OnCalendar=*-*-* 01:50:00 Asia/Hong_Kong
OnCalendar=*-*-* 02:20:00 Asia/Hong_Kong
OnCalendar=*-*-* 02:50:00 Asia/Hong_Kong
OnCalendar=*-*-* 03:20:00 Asia/Hong_Kong
OnCalendar=*-*-* 03:50:00 Asia/Hong_Kong
OnCalendar=*-*-* 04:20:00 Asia/Hong_Kong
OnCalendar=*-*-* 04:50:00 Asia/Hong_Kong
OnCalendar=*-*-* 05:20:00 Asia/Hong_Kong
OnCalendar=*-*-* 05:50:00 Asia/Hong_Kong
OnCalendar=*-*-* 06:20:00 Asia/Hong_Kong
RandomizedDelaySec=2min
AccuracySec=1min
Persistent=false
Unit=ciclotrade-candidate-producer.service

[Install]
WantedBy=timers.target
