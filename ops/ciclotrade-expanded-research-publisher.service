[Unit]
Description=CicloTrade expanded 97-symbol research publisher (disabled-first)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cicloworker
Group=cicloworker
EnvironmentFile=/etc/ciclotrade-worker/expanded-research-publisher.env
WorkingDirectory=/opt/ciclotrade-worker/current
ExecStart=/opt/ciclotrade-worker/current/.venv/bin/python -m src.apps.worker.expanded_research_publisher --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/ciclotrade-worker/expanded-research/spool
ReadWritePaths=/var/lib/ciclotrade-worker/expanded-research/publisher
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
