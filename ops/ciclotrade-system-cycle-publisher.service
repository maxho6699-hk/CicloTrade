[Unit]
Description=CicloTrade signed system-cycle shadow publisher
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/ciclotrade-worker
ConditionPathExists=/etc/ciclotrade-worker/enable-system-cycle-publisher.after-integration

[Service]
Type=oneshot
User=cicloworker
Group=cicloworker
WorkingDirectory=/opt/ciclotrade-worker/current
EnvironmentFile=/etc/ciclotrade-worker/publisher.env
ExecStart=/opt/ciclotrade-worker/current/.venv/bin/python -m src.apps.worker.system_cycle_publisher
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=false
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/ciclotrade-worker /var/log/ciclotrade-worker
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%
TasksMax=32
LimitNOFILE=1024
