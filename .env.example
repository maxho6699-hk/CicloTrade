# TradeAI runtime configuration. Copy to .env and fill only the services you enable.
APP_NAME=TradeAI
APP_ENV=production
APP_BASE_URL=https://your-domain.example
TIMEZONE=Asia/Hong_Kong
DATABASE_URL=sqlite:///data/tradeai.db
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_SECRET_KEY=replace-with-a-different-long-random-secret-at-least-32-chars
# Optional key separation for opaque earnings research identifiers. When empty,
# the API derives a domain-separated key from JWT_SECRET_KEY/SECRET_KEY.
EARNINGS_OPAQUE_ID_SECRET=
# Official real-quote option simulation. All switches default off. The read
# opaque-id key and worker HMAC secret must be independent values with at least
# 32 characters; neither falls back to JWT or earnings secrets.
OFFICIAL_OPTION_SIMULATION_ENABLED=false
OFFICIAL_OPTION_SIMULATION_RECEIVER_ENABLED=false
OFFICIAL_OPTION_SIM_OPAQUE_ID_SECRET=
OFFICIAL_OPTION_SIMULATION_SHARED_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_EMAIL_VERIFICATION=true
TRADEAI_ADMIN_EMAIL=
TRADEAI_ADMIN_PASSWORD=

# Enable only behind a trusted reverse proxy that overwrites client forwarding headers.
TRUST_PROXY_HEADERS=false

# Market data: yfinance is research-grade; the current Polygon adapter provides daily aggregates only.
# wrdata is intentionally disabled until its vendor SDK and credentials can be verified.
DATA_SOURCE=opend
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
# OpenD's Telnet control port remains fixed on loopback at 22222.
# The admin console never exposes this port publicly.
OPEND_CLIENT_HOME=/var/lib/ciclotrade
MARKET_DATA_ENABLED=false
POLYGON_API_KEY=
# Set true only after the selected adapter exposes an authorized real-time feed.
# The UI never labels a source real-time from this flag alone.
MARKET_DATA_REALTIME=false

# Signed receiver for research-only system-cycle evidence from the isolated
# strategy node. This receiver is disabled by default and uses its own SQLite
# file; it must never share DATABASE_URL or TRADEAI_BACKTEST_DATABASE_URL.
# Keep the shared secret independent from all login, payment, broker, OpenD,
# and backtest credentials. Set it only with a root-owned production .env.
TRADEAI_SYSTEM_CYCLE_RESEARCH_RECEIVER_ENABLED=false
TRADEAI_SYSTEM_CYCLE_RESEARCH_DATABASE=/var/lib/ciclotrade/system-cycle-research.db
TRADEAI_SYSTEM_CYCLE_RESEARCH_SHARED_SECRET=

# External strategy engine ingest. Generate a unique random token of at least 32 characters.
# POST immutable events and equity snapshots to /api/v1/quant/* with Authorization: Bearer <token>.
TRADEAI_SYSTEM_LEDGER_KEY=tradeai-system
TRADEAI_STRATEGY_INGEST_TOKEN=

# Tiger OpenAPI: current live adapter supports US stock limit orders, not A-share live orders.
# Keep the environment on paper and the live switch off until account authorization and paper QA pass.
TIGER_ID=
TIGER_ACCOUNT=
TIGER_PRIVATE_KEY=
# Preferred: point to the official properties file instead of copying secrets into environment variables.
TIGER_PROPERTIES_PATH=
TIGER_ENV=paper
TIGER_REAL_TRADING_ENABLED=false
# Legacy public surfaces are fail-closed until a deliberate launch decision.
TRADEAI_LEGACY_ORDER_WRITE_ENABLED=false
TRADEAI_LEGACY_TRADING_UI_ENABLED=false
TRADEAI_STOCK_AUTO_CONTRACT_USER_IDS=
TRADEAI_LIVE_OPERATOR_USER_ID=

# Isolated strategy runner. Keep the service bound to server loopback only.
TRADEAI_SANDBOX_URL=
TRADEAI_SANDBOX_TOKEN=

# One-time manual payments. These details are shown only to an authenticated purchaser.
# Include only receiving instructions; never put banking, Alipay, or WeChat login credentials here.
FPS_PAYMENT_INSTRUCTIONS=
ALIPAY_PAYMENT_INSTRUCTIONS=
WECHAT_PAYMENT_INSTRUCTIONS=
# Browser screenshots are sanitized and stored outside the public web root.
PAYMENT_PROOF_DIR=/var/lib/ciclotrade/payment-proofs
# TG 财务管理员上传的收款二维码；必须位于非公开目录。
PAYMENT_RECEIVER_ASSET_DIR=/var/lib/ciclotrade/payment-receiver-assets

# Telegram and SMTP notifications. Keep external jobs disabled until delivery is verified.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_SUMMARY_ENABLED=false
TELEGRAM_GROUP_SIGNALS_ENABLED=false
TELEGRAM_FREE_DELAYED_SIGNALS_ENABLED=false
TELEGRAM_MEMBERSHIP_SYNC_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CicloTrade <support@ciclotrade.com>
SUPPORT_EMAIL=support@ciclotrade.com
SCHEDULER_ENABLED=false
EXTERNAL_ALERTS_ENABLED=false

# Canonical research backtest queue. All endpoints are fail-closed until each
# flag is deliberately enabled. Keep the worker token private and at least 32 characters.
TRADEAI_BACKTEST_QUEUE_ENABLED=false
TRADEAI_BACKTEST_WORKER_API_ENABLED=false
TRADEAI_BACKTEST_CLAIMS_ENABLED=false
TRADEAI_BACKTEST_WORKER_TOKEN=
TRADEAI_BACKTEST_ARTIFACT_DIR=/var/lib/ciclotrade/backtest-artifacts
TRADEAI_BACKTEST_ARTIFACT_MAX_BYTES=8388608
