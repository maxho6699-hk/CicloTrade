{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciclotrade.com/contracts/model-version.v1.schema.json",
  "title": "CicloTrade Governed Model Version V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_id", "version", "instrument_family", "state", "source_hash", "metrics"],
  "properties": {
    "model_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "instrument_family": { "enum": ["equity", "option"] },
    "state": { "enum": ["draft", "trained", "shadow", "paper_qualified", "approved", "active", "degraded", "retired"] },
    "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metrics": {
      "type": "object",
      "required": ["sample_size", "out_of_sample_ratio", "stress_expectancy", "max_drawdown", "parameter_stability", "regimes_passed"],
      "properties": {
        "sample_size": { "type": "integer", "minimum": 0 },
        "out_of_sample_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "stress_expectancy": { "type": "number" },
        "max_drawdown": { "type": "number", "minimum": 0, "maximum": 1 },
        "parameter_stability": { "type": "number", "minimum": 0, "maximum": 1 },
        "regimes_passed": { "type": "integer", "minimum": 0 }
      }
    },
    "approval_receipt": { "type": ["string", "null"] },
    "rollback_version": { "type": ["string", "null"] }
  }
}
